# Copy this file to .env and fill in your own values. .env is gitignored.
# Never commit a real key.

# Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Model used by the storyteller agent (Stage 1 design: Claude Sonnet 5.5)
STORYTELLER_MODEL=claude-sonnet-5-5

# Folder where story sessions are saved as JSON
STORYTELLER_SAVE_DIR=saves
