# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Personal project and workflow notes
.notes

# Microsoft Office lock files
~$*
.DS_Store

# Secrets: never commit API keys
.env
.env.*
!.env.example
config.local.json

# Build output
target/

# Local story saves (sample data lives in samples/)
saves/

# Editors (shared VS Code settings are committed; personal state is not)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml
