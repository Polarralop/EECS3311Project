<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ca.yorku</groupId>
  <artifactId>storyteller</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>AI Interactive Storyteller</name>
  <description>EECS 3311 agent project: an AI storyteller with GUI and CLI front ends.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <anthropic.version>2.74.0</anthropic.version>
    <jackson.version>2.22.4</jackson.version>
    <dotenv.version>3.2.0</dotenv.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencies>
    <!-- Adaptee behind ClaudeAdapter (Adapter pattern) -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic.version}</version>
    </dependency>
    <!-- JSON save files (JsonSessionRepository) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- Reads ANTHROPIC_API_KEY and settings from .env -->
    <dependency>
      <groupId>io.github.cdimascio</groupId>
      <artifactId>dotenv-java</artifactId>
      <version>${dotenv.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <!-- mvn compile exec:java@gui  /  mvn compile exec:java@cli -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>gui</id>
            <configuration>
              <mainClass>ca.yorku.storyteller.ui.StoryGUI</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>cli</id>
            <configuration>
              <mainClass>ca.yorku.storyteller.ui.StoryCLI</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
